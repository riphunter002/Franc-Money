// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  password_hash String
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  transactions  Transaction[]
  categories    Category[]
  budgets       Budget[]
  importedTransactions ImportedTransaction[]
  recurringTransactions RecurringTransaction[]

  @@map("users") // <-- Força a tabela a se chamar 'users'
}

model Category {
  id          String        @id @default(uuid())
  name        String
  type        String        @default("EXPENSE")
  color       String        @default("#8b93a1")
  user_id     String
  created_at  DateTime      @default(now())

  user        User          @relation(fields: [user_id], references: [id])
  transactions Transaction[]
  budget      Budget?
  importedTransactions ImportedTransaction[]
  recurringTransactions RecurringTransaction[]

  @@unique([name, user_id])
  @@map("categories") // <-- Força a tabela a se chamar 'categories'
}

// Limite de gasto mensal por categoria. É recorrente (não tem mês/ano): um
// único valor por categoria, sempre comparado com os gastos do mês atual.
model Budget {
  id          String   @id @default(uuid())
  amount      Decimal
  user_id     String
  category_id String   @unique
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user     User     @relation(fields: [user_id], references: [id])
  category Category @relation(fields: [category_id], references: [id])

  @@map("budgets") // <-- Força a tabela a se chamar 'budgets'
}

// Linha crua de um CSV de fatura importado, esperando revisão do usuário
// (categoria, título, valor, data e tipo podem ser corrigidos antes de virar
// uma Transaction de verdade). Fica isolada de tudo — resumo do dashboard,
// gráficos e orçamentos não sabem que ela existe até ser confirmada.
model ImportedTransaction {
  id          String   @id @default(uuid())
  title       String
  amount      Decimal
  type        String   @default("EXPENSE")
  date        DateTime
  user_id     String
  category_id String?
  created_at  DateTime @default(now())

  user     User      @relation(fields: [user_id], references: [id])
  category Category? @relation(fields: [category_id], references: [id])

  @@map("imported_transactions") // <-- Força a tabela a se chamar 'imported_transactions'
}

// "Receita" que gera transações automaticamente: uma compra parcelada
// (installments_total definido, gera todas as parcelas já na criação) ou
// uma recorrência sem fim como salário/aluguel (installments_total nulo,
// gera só a primeira na criação e as próximas conforme o app é aberto —
// ver generateDueRecurringTransactions em recurringTransactionService.js).
model RecurringTransaction {
  id                      String    @id @default(uuid())
  title                   String
  description             String?
  amount                  Decimal
  type                    String
  start_date              DateTime
  installments_total      Int?
  installments_generated  Int       @default(0)
  // false = parou de gerar novas (parcelamento já completo, ou cancelada
  // manualmente); transações já geradas continuam intactas
  active                  Boolean   @default(true)
  user_id                 String
  category_id             String?
  created_at              DateTime  @default(now())

  user         User          @relation(fields: [user_id], references: [id])
  category     Category?     @relation(fields: [category_id], references: [id])
  transactions Transaction[]

  @@map("recurring_transactions") // <-- Força a tabela a se chamar 'recurring_transactions'
}

model Transaction {
  id          String    @id @default(uuid())
  title       String
  description String?
  amount      Decimal
  type        String
  date        DateTime  @default(now())
  user_id     String
  category_id String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  // Preenchidos só quando a transação veio de uma recorrência/parcelamento
  recurring_transaction_id String?
  installment_number       Int?

  user        User      @relation(fields: [user_id], references: [id])
  category    Category? @relation(fields: [category_id], references: [id])
  recurringTransaction RecurringTransaction? @relation(fields: [recurring_transaction_id], references: [id])

  @@map("transactions") // <-- Força a tabela a se chamar 'transactions'
}