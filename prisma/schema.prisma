// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  password_hash String
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  transactions  Transaction[]
  categories    Category[]

  @@map("users") // <-- Força a tabela a se chamar 'users'
}

model Category {
  id          String        @id @default(uuid())
  name        String
  user_id     String
  created_at  DateTime      @default(now())

  user        User          @relation(fields: [user_id], references: [id])
  transactions Transaction[]

  @@unique([name, user_id])
  @@map("categories") // <-- Força a tabela a se chamar 'categories'
}

model Transaction {
  id          String    @id @default(uuid())
  title       String
  description String?
  amount      Decimal
  type        String
  date        DateTime  @default(now())
  user_id     String
  category_id String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  user        User      @relation(fields: [user_id], references: [id])
  category    Category? @relation(fields: [category_id], references: [id])

  @@map("transactions") // <-- Força a tabela a se chamar 'transactions'
}